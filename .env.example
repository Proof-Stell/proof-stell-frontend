# ────────────────────────────────────────────────────────────────────────────
# ProofStell Frontend — Environment Variables
# ────────────────────────────────────────────────────────────────────────────
#
# This file documents all environment variables used by the ProofStell Frontend.
#
# SETUP:
#   1. Copy this file to `.env.local`:
#        cp .env.example .env.local
#
#   2. Fill in the required values for your environment.
#
#   3. `.env.local` is gitignored and will not be committed.
#
# VALIDATION:
#   • All NEXT_PUBLIC_* variables are bundled into the browser JavaScript.
#   • Secrets (private keys, API secrets) must NEVER be NEXT_PUBLIC_*.
#   • Build-time validation runs automatically via `npm run build`.
#   • Run validation manually: `npm run validate:env`
#
# ────────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════════
# STELLAR / SOROBAN CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# Configure blockchain RPC endpoints and network identifiers.

# ── Soroban RPC URL ──────────────────────────────────────────────────────────
# RPC endpoint for interacting with Soroban smart contracts.
#
# REQUIRED:     dev, staging, production
# FORMAT:       URL (https://...)
# EXAMPLES:
#   Testnet:    https://soroban-testnet.stellar.org
#   Mainnet:    https://soroban-mainnet.stellar.org
#
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Soroban Network Passphrase ───────────────────────────────────────────────
# Identifies the Stellar network (mainnet or testnet).
# Must match the network of your RPC endpoint.
#
# REQUIRED:     dev, staging, production
# FORMAT:       String
# EXAMPLES:
#   Testnet:    "Test SDF Network ; September 2015"
#   Mainnet:    "Public Global Stellar Network ; September 2015"
#
NEXT_PUBLIC_SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ── Stellar Horizon URL ──────────────────────────────────────────────────────
# REST API endpoint for Stellar account and transaction queries.
#
# REQUIRED:     dev, staging, production
# FORMAT:       URL (https://...)
# EXAMPLES:
#   Testnet:    https://horizon-testnet.stellar.org
#   Mainnet:    https://horizon.stellar.org
#
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# ═══════════════════════════════════════════════════════════════════════════
# SMART CONTRACT ADDRESSES
# ═══════════════════════════════════════════════════════════════════════════
# Deployed Soroban contract identifiers.

# ── ProofStell Contract ID ───────────────────────────────────────────────────
# Address of the deployed ProofStell document verification contract.
#
# REQUIRED:     dev, staging, production
# FORMAT:       56-character Soroban contract address (starts with C)
# EXAMPLE:      CCCC1234567890ABCDEF1234567890ABCDEF1234567890ABCDEF12345
#
NEXT_PUBLIC_PROOFSTELL_CONTRACT_ID=CCCC...

# ── Issuer Contract ID ───────────────────────────────────────────────────────
# Address of the deployed Issuer contract (required for issuer portal).
#
# REQUIRED:     production (when issuer portal is enabled)
# OPTIONAL:     dev, staging
# FORMAT:       56-character Soroban contract address (starts with C)
# EXAMPLE:      CCCC1234567890ABCDEF1234567890ABCDEF1234567890ABCDEF12345
#
NEXT_PUBLIC_ISSUER_CONTRACT_ID=CCCC...

# ═══════════════════════════════════════════════════════════════════════════
# WALLET CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# ── Wallet Providers ─────────────────────────────────────────────────────────
# Comma-separated list of enabled wallet providers.
#
# REQUIRED:     No (defaults to all available providers if not set)
# OPTIONAL:     dev, staging, production
# FORMAT:       Comma-separated string (no spaces)
# SUPPORTED:    freighter, xbull
# EXAMPLES:
#   Single:     freighter
#   Multiple:   freighter,xbull
#
NEXT_PUBLIC_WALLET_PROVIDERS=freighter,xbull

# ═══════════════════════════════════════════════════════════════════════════
# API CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# ProofStell REST API configuration (for leaderboard, analytics, etc.).

# ── API Base URL ─────────────────────────────────────────────────────────────
# Base URL of the ProofStell REST API.
# If not set, the app falls back to bundled mock data.
#
# REQUIRED:     production
# OPTIONAL:     dev, staging (can use mock data)
# FORMAT:       URL (https://...)
# EXAMPLES:
#   Production: https://api.proofstell.io
#   Staging:    https://api-staging.proofstell.io
#   Local:      http://localhost:3001
#
NEXT_PUBLIC_API_BASE_URL=https://api.proofstell.io

# ── API Key ──────────────────────────────────────────────────────────────────
# Public/read-only API key for REST API (if required by your backend).
#
# ⚠ WARNING:   This is a NEXT_PUBLIC_* variable — it will be visible in the
#              browser JavaScript bundle. Only set this if the key is
#              intentionally public and read-only (no write permissions).
#
# REQUIRED:     No (depends on your API authentication requirements)
# OPTIONAL:     dev, staging, production
# FORMAT:       String
# EXAMPLE:      pk_live_1234567890abcdef
#
NEXT_PUBLIC_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# APPLICATION CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# ── App Environment ──────────────────────────────────────────────────────────
# Deployment environment tag. Controls feature flags, error reporting,
# analytics, and logging behavior.
#
# REQUIRED:     production (enforces stricter validation)
# OPTIONAL:     dev, staging
# FORMAT:       Enum (development | staging | production)
# DEFAULT:      development (if not set)
#
NEXT_PUBLIC_APP_ENV=development

# ── Log Level ────────────────────────────────────────────────────────────────
# Minimum log level emitted to the browser console.
#
# REQUIRED:     No
# OPTIONAL:     dev, staging, production
# FORMAT:       Enum (debug | info | warn | error)
# DEFAULT:      info (if not set)
# RECOMMENDED:
#   dev:        debug
#   staging:    info
#   production: warn or error
#
NEXT_PUBLIC_LOG_LEVEL=debug

# ── Enable Mock Data ─────────────────────────────────────────────────────────
# Set to "true" to serve bundled mock data instead of live API calls.
# Useful for local development and demos when the backend API is unavailable.
#
# ⚠ WARNING:   Must be "false" or removed entirely in production builds.
#              Build validation will fail if set to "true" in production.
#
# REQUIRED:     No
# OPTIONAL:     dev, staging
# FORMAT:       Boolean string ("true" | "false")
# DEFAULT:      false (if not set)
#
NEXT_PUBLIC_ENABLE_MOCK_DATA=true

# ═══════════════════════════════════════════════════════════════════════════
# BUILD CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# ── Skip Environment Validation ──────────────────────────────────────────────
# Set to "1" to skip strict environment validation during `next build`.
# This is useful for running the dev server with an incomplete .env.local
# during local development.
#
# ⚠ WARNING:   DO NOT use this in CI/CD or production builds. Validation
#              exists to prevent misconfigured deployments.
#
# REQUIRED:     No (never set in production)
# OPTIONAL:     dev only (local development)
# FORMAT:       "1" to skip, any other value or unset to run validation
# DEFAULT:      Validation runs (if not set)
#
# SKIP_ENV_VALIDATION=1

# ────────────────────────────────────────────────────────────────────────────
# END OF CONFIGURATION
# ────────────────────────────────────────────────────────────────────────────
#
# VALIDATION COMMANDS:
#   npm run validate:env    — Run standalone validation script
#   npm run build           — Runs validation automatically before building
#
# TROUBLESHOOTING:
#   If you see "Missing required env vars" errors during build:
#   1. Ensure you copied .env.example to .env.local
#   2. Fill in all REQUIRED variables for your target environment
#   3. Run `npm run validate:env` to see detailed error messages
#
# For more information, see: README.md § Environment Variables
# ────────────────────────────────────────────────────────────────────────────
